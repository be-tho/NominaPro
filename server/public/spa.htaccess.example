# Renombrar a .htaccess dentro de public_html/nomina (subdominio con raíz en esa carpeta).
# Sirve index.html para rutas del SPA si más adelante usás React Router u otras URLs directas.

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
